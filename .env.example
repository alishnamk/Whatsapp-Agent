# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-string-and-reuse-it-in-meta-console

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Shared secret your Cowork schedule (or curl) must send as
# "Authorization: Bearer <value>" when POSTing to /api/send-report.
# Optional but recommended if this app is deployed publicly.
REPORT_WEBHOOK_SECRET=choose-a-random-string
